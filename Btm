<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Bloom Together Mums is a welcoming community in Wembley and Brent where mums can connect, make friends and enjoy activities together.">
  <meta name="theme-color" content="#fff8f2">
  <title>Bloom Together Mums | Community in Wembley & Brent</title>

  <style>
    :root {
      --ink:#3f3b38;
      --muted:#6c625d;
      --rose:#c96f82;
      --rose-dark:#a94f65;
      --cream:#fff8f2;
      --pink:#f9e6e8;
      --sage:#e9f0e5;
      --white:#fff;
      --line:#f0ded9;
    }

    * { box-sizing:border-box; }

    html { scroll-behavior:smooth; }

    body {
      margin:0;
      font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      color:var(--ink);
      background:#fff;
      line-height:1.65;
    }

    a { color:inherit; }

    .wrap {
      width:min(1100px,92%);
      margin:auto;
    }

    .topbar {
      background:var(--cream);
      padding:14px 0;
      border-bottom:1px solid var(--line);
    }

    .nav {
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:18px;
    }

    .brand {
      font-weight:800;
      color:var(--rose-dark);
      font-size:1.1rem;
      text-decoration:none;
    }

    .navlinks {
      display:flex;
      gap:20px;
      flex-wrap:wrap;
    }

    .navlinks a {
      text-decoration:none;
      font-size:.94rem;
    }

    .hero {
      background:linear-gradient(135deg,var(--cream),var(--pink));
      padding:76px 0 70px;
    }

    .hero-grid {
      display:grid;
      grid-template-columns:1.3fr .7fr;
      align-items:center;
      gap:40px;
    }

    .eyebrow {
      color:var(--rose-dark);
      font-weight:750;
      letter-spacing:.08em;
      text-transform:uppercase;
      font-size:.78rem;
    }

    h1 {
      font-size:clamp(2.4rem,6vw,4.5rem);
      line-height:1.08;
      letter-spacing:-.04em;
      margin:12px 0 20px;
    }

    h2 {
      font-size:clamp(1.7rem,4vw,2.5rem);
      line-height:1.2;
      margin:0 0 14px;
      letter-spacing:-.025em;
    }

    h3 { margin:0 0 8px; }

    p {
      color:var(--muted);
      margin:0 0 16px;
    }

    .hero p {
      font-size:1.1rem;
      max-width:620px;
    }

    .actions {
      display:flex;
      gap:12px;
      flex-wrap:wrap;
      margin-top:24px;
    }

    .btn {
      display:inline-flex;
      align-items:center;
      justify-content:center;
      padding:12px 19px;
      border-radius:999px;
      text-decoration:none;
      font-weight:700;
      border:2px solid var(--rose-dark);
    }

    .btn.primary {
      background:var(--rose-dark);
      color:white;
    }

    .btn.secondary {
      color:var(--rose-dark);
      background:transparent;
    }

    .flower-card {
      background:rgba(255,255,255,.72);
      border:1px solid #fff;
      border-radius:30px;
      padding:32px;
      text-align:center;
      box-shadow:0 15px 45px #8b53601a;
    }

    .flower {
      font-size:5rem;
      line-height:1.2;
    }

    .flower-card strong {
      display:block;
      font-size:1.25rem;
      margin:14px 0 5px;
    }

    .section { padding:68px 0; }

    .section.tint { background:#fffaf7; }

    .intro {
      max-width:720px;
      margin-bottom:28px;
    }

    .cards {
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:18px;
    }

    .card {
      padding:24px;
      border:1px solid var(--line);
      border-radius:22px;
      background:white;
    }

    .card .emoji {
      font-size:1.8rem;
      margin-bottom:10px;
    }

    .soft-card {
      background:var(--sage);
      border-radius:26px;
      padding:30px;
    }

    .two-col {
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:26px;
      align-items:center;
    }

    .list {
      padding-left:20px;
      color:var(--muted);
    }

    .list li { margin:8px 0; }

    .cta {
      background:var(--rose-dark);
      color:white;
      padding:48px 0;
    }

    .cta h2,.cta p { color:white; }

    .cta .btn {
      background:white;
      color:var(--rose-dark);
      border-color:white;
    }

    .cta .btn.secondary {
      background:transparent;
      color:white;
      border-color:white;
    }

    .footer {
      background:#302c2a;
      color:#fff;
      padding:28px 0;
    }

    .footer p {
      color:#e6dcd8;
      font-size:.9rem;
    }

    .footer-row {
      display:flex;
      justify-content:space-between;
      gap:20px;
      flex-wrap:wrap;
    }

    .small { font-size:.88rem; }

    .pill {
      display:inline-block;
      background:white;
      border:1px solid var(--line);
      border-radius:999px;
      padding:6px 11px;
      margin:4px 4px 0 0;
      font-size:.88rem;
      color:var(--muted);
    }

    @media(max-width:760px) {
      .hero-grid,.two-col {
        grid-template-columns:1fr;
      }

      .hero { padding:54px 0; }

      .flower-card { max-width:420px; }

      .cards { grid-template-columns:1fr; }

      .nav {
        align-items:flex-start;
        flex-direction:column;
      }

      .navlinks { gap:12px; }

      .section { padding:52px 0; }
    }
  </style>
</head>

<body>

<header class="topbar">
  <div class="wrap nav">
    <a class="brand" href="#home">🌸 Bloom Together Mums</a>

    <nav class="navlinks" aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#activities">What we do</a>
      <a href="#welcome">Who can join?</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<main>

  <section class="hero" id="home">
    <div class="wrap hero-grid">

      <div>
        <div class="eyebrow">A mums' community in Wembley & Brent</div>

        <h1>No mum should have to do motherhood alone.</h1>

        <p>
          A warm, inclusive space for mums to meet, make friendships,
          share experiences and enjoy time together—with little ones welcome too.
        </p>

        <div class="actions">
          <a class="btn primary"
             href="https://wa.me/447448760063?text=Hi%20Bloom%20Together%20Mums%2C%20I%27d%20love%20to%20find%20out%20about%20your%20community."
             target="_blank" rel="noopener">
            Message us on WhatsApp
          </a>

          <a class="btn secondary"
             href="https://www.instagram.com/bloomtogethermums08/"
             target="_blank" rel="noopener">
            Follow on Instagram
          </a>
        </div>
      </div>

      <div class="flower-card">
        <div class="flower" aria-hidden="true">🌷🌼🌷</div>
        <strong>Connect. Share. Bloom.</strong>
        <p class="small">
          Friendship, community and little moments of wellbeing for mums.
        </p>
        <span class="pill">Welcoming</span>
        <span class="pill">Inclusive</span>
        <span class="pill">Family-friendly</span>
      </div>

    </div>
  </section>

  <section class="section" id="about">
    <div class="wrap two-col">

      <div>
        <div class="eyebrow">Our story</div>

        <h2>A little connection can make a big difference.</h2>

        <p>
          Bloom Together Mums was created to help mothers feel less isolated
          and more connected. Motherhood can be beautiful, but it can also
          feel lonely or overwhelming. We want to offer a friendly,
          non-judgemental place where mums can feel heard, meet other parents
          and build a sense of belonging.
        </p>

        <p>
          We are a community for connection and peer support—not a replacement
          for professional medical or mental-health care.
        </p>
      </div>

      <div class="soft-card">
        <h3>Our community values</h3>

        <ul class="list">
          <li>Kindness and mutual respect</li>
          <li>A welcoming, non-judgemental atmosphere</li>
          <li>Making space for different backgrounds and experiences</li>
          <li>Helping mums form real local friendships</li>
          <li>Children are welcome at suitable meet-ups</li>
        </ul>
      </div>

    </div>
  </section>

  <section class="section tint" id="activities">
    <div class="wrap">

      <div class="intro">
        <div class="eyebrow">Come as you are</div>

        <h2>Ways to connect and spend time together</h2>

        <p>
          Activities may vary by month. Message us to ask about the next
          meet-up, location, availability and any costs.
        </p>
      </div>

      <div class="cards">

        <article class="card">
          <div class="emoji">☕</div>
          <h3>Coffee & chat</h3>
          <p>
            Relaxed meet-ups to talk, share experiences and get to know other mums.
          </p>
        </article>

        <article class="card">
          <div class="emoji">🧸</div>
          <h3>Family-friendly meet-ups</h3>
          <p>
            Opportunities to meet other parents while little ones can join in
            where the activity allows.
          </p>
        </article>

        <article class="card">
          <div class="emoji">🌿</div>
          <h3>Walks & picnics</h3>
          <p>
            Enjoy fresh air and friendly company with other local mums and families.
          </p>
        </article>

        <article class="card">
          <div class="emoji">🎨</div>
          <h3>Creative activities</h3>
          <p>
            Crafts and simple activities that offer a chance to unwind and connect.
          </p>
        </article>

        <article class="card">
          <div class="emoji">💛</div>
          <h3>Wellbeing & conversation</h3>
          <p>
            A supportive space for honest conversations, encouragement and
            feeling less alone.
          </p>
        </article>

        <article class="card">
          <div class="emoji">🎉</div>
          <h3>Community celebrations</h3>
          <p>
            Seasonal, cultural and family events that bring people together.
          </p>
        </article>

      </div>
    </div>
  </section>

  <section class="section" id="welcome">
    <div class="wrap two-col">

      <div class="soft-card">
        <div class="flower" aria-hidden="true">🤍</div>

        <h2>You are welcome here.</h2>

        <p>
          Whether you are new to Wembley, new to motherhood, living far from
          family, or simply hoping to make friends, there is room for you
          in our community.
        </p>
      </div>

      <div>
        <div class="eyebrow">Getting started</div>

        <h2>Join the conversation</h2>

        <p>
          Send us a message and tell us a little about what you are looking for.
          We can share details of upcoming activities and explain how to join.
        </p>

        <p>
          Before attending, please confirm the venue, date, any costs and
          whether you need to book a place.
        </p>

        <a class="btn primary"
           href="https://wa.me/447448760063?text=Hi%2C%20please%20could%20you%20tell%20me%20about%20upcoming%20Bloom%20Together%20Mums%20meet-ups%3F"
           target="_blank" rel="noopener">
          Ask about upcoming meet-ups
        </a>
      </div>

    </div>
  </section>

  <section class="cta" id="contact">
    <div class="wrap two-col">

      <div>
        <h2>Let's help mums feel more connected.</h2>

        <p>
          Interested in joining, volunteering, partnering or supporting
          the community? We'd love to hear from you.
        </p>
      </div>

      <div class="actions">
        <a class="btn" href="https://wa.me/447448760063"
           target="_blank" rel="noopener">
          WhatsApp: 07448 760063
        </a>

        <a class="btn secondary"
           href="https://www.instagram.com/bloomtogethermums08/"
           target="_blank" rel="noopener">
          Instagram @bloomtogethermums08
        </a>
      </div>

    </div>
  </section>

</main>

<footer class="footer">
  <div class="wrap footer-row">

    <div>
      <strong>🌸 Bloom Together Mums</strong>
      <p class="small">
        A community for mums in Wembley and Brent, London.
      </p>
    </div>

    <p class="small">
      © <span id="year"></span> Bloom Together Mums.
      Please message us to confirm upcoming event details.
    </p>

  </div>
</footer>

<script>
  document.getElementById('year').textContent = new Date().getFullYear();
</script>

</body>
</html>
